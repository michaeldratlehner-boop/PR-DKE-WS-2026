# Vorlage fuer das Team. Kopieren nach .env und echte Werte eintragen:
#   cp .env.example .env
# Die .env selbst wird NIE committet (steht in .gitignore).

# --- Direkte Postgres-Verbindung (fuer SQL-Dateien, psql, psycopg) ---
# Dashboard > Project Settings > Database
DATABASE_URL=postgresql://postgres.dsdyyaszmxeoscjxqwch:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# --- Supabase-API (fuer die Python-Skripte) ---
# Dashboard > Project Settings > API
SUPABASE_URL=https://dein-projekt.supabase.co

# ACHTUNG: service_role-Key (bzw. "secret key") umgeht RLS komplett.
# Nur lokal verwenden, nie im Frontend.
SUPABASE_KEY=dein-service-role-key

# --- Hier unseren Gemini - API Key eintragen ---
GEMINI_API_KEY=emini-key

# --- Hier unseren Ausweich - API Key eintragen ---
AUSWEICH_API_KEY=ausweich-key